# Copy to .env and fill in. Never commit .env.
# Any variable may instead be supplied as <NAME>_FILE=/path/to/file
# (e.g. a Docker secret). If both are set, the file wins.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
SUBSTACK_PUBLICATION_URL=
SUBSTACK_COOKIE=
RUN_TIME=08:30
TZ=Europe/London
POST_MIN_WORDS=250
POST_MAX_WORDS=600
MAX_PENDING_DRAFTS=7
FETCH_TIMEOUT_SECONDS=10
